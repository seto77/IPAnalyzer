    <value>メイリオ, 9pt</value>
  </data>
  <data name="checkBoxThresholdMax.Text" xml:space="preserve">
    <value>強度が右値以上</value>
  </data>
  <data name="checkBoxThresholdMax.ToolTip" xml:space="preserve">
