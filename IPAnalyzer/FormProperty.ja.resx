や異常高強度ピクセルの除去に使用します。</value>
  </data>
  <data name="checkBoxThresholdMin.Font" type="System.Drawing.Font, System.Drawing">
    <value>メイリオ, 9pt</value>
  </data>
  <data name="checkBoxThresholdMin.Text" xml:space="preserve">
    <value>強度が右値以下</value>
  </data>
